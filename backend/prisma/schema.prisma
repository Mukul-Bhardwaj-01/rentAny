// Prisma schema for RentAny: users (auth), items (listings with media),
// hourly bookings, payments (Razorpay) and refundable security deposits.
// Reviews, maps and the chatbot are later phases and are intentionally left out.
//
// Raw-SQL constraints Prisma can't express live in the migration files:
// see migrations/*_bookings, *_payments_* (CHECKs + the overlap exclusion).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN // can resolve disputed deposit claims; set manually in the database for now
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  // Required at registration (enforced by the API), but kept nullable here
  // because accounts created before that rule may not have one.
  phone        String?
  role         UserRole @default(USER)
  // Ratings received, kept as exact sums (average = sum / count), updated in
  // the same transaction as each review. Separate for each side of a rental.
  ownerRatingSum    Int @default(0)
  ownerRatingCount  Int @default(0)
  renterRatingSum   Int @default(0)
  renterRatingCount Int @default(0)
  createdAt    DateTime @default(now())

  items           Item[]
  rentals         Booking[] @relation("RenterBookings")
  bookingRequests Booking[] @relation("OwnerBookings")
  notifications   Notification[]
  mediaUploads    MediaUpload[]
  reviewsWritten  Review[] @relation("ReviewsWritten")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model Item {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  category        String
  pricePerHour    Decimal  @db.Decimal(10, 2)
  // Refundable deposit the owner asks for (0 to 50,000). Copied onto each
  // booking when it is requested, so later changes don't affect it.
  securityDeposit Decimal  @default(0) @db.Decimal(10, 2)
  // Legacy single image, kept for backward compatibility. Now maintained as
  // the listing's cover: the first IMAGE in media (null if there is none).
  imageUrl        String?
  location        String
  // Owner's on/off switch for the listing. Whether a specific time slot is
  // free comes from the item's ACCEPTED/CONFIRMED/ACTIVE bookings.
  isAvailable     Boolean  @default(true)
  // Ratings from renters' reviews (average = ratingSum / ratingCount).
  ratingSum       Int      @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  // Set when the owner deletes the listing. The row stays because bookings,
  // payments and reviews reference it; deleted listings are hidden everywhere
  // and never available (CHECK constraint in the migration).
  deletedAt       DateTime?

  owner         User     @relation(fields: [ownerId], references: [id])
  ownerId       Int

  bookings      Booking[]
  media         ItemMedia[]
  mediaUploads  MediaUpload[]
  reviews       Review[]

  @@index([ownerId])
}

enum MediaType {
  IMAGE
  VIDEO
}

// Photos and videos of a listing, shown in sortOrder.
model ItemMedia {
  id        Int       @id @default(autoincrement())
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
  type      MediaType
  url       String
  // Cloudinary public id, needed to delete the asset. Null only for legacy
  // images whose URL wasn't a Cloudinary upload of ours.
  // Unique: one Cloudinary asset can belong to only one listing.
  publicId  String?   @unique
  sortOrder Int
  createdAt DateTime  @default(now())

  // Also serves as the index for loading an item's media in order.
  @@unique([itemId, sortOrder])
}

// A signed direct-to-Cloudinary upload the server has authorised but that
// is not (yet) part of a listing. The browser uploads to exactly this public
// id; the row is consumed when the asset is attached to an item. Rows that
// expire unclaimed are swept: their Cloudinary asset is deleted.
model MediaUpload {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique
  // Who may attach it, and to which listing (null = a listing being created).
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int?
  type      MediaType
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([itemId])
  @@index([expiresAt])
}

enum BookingStatus {
  PENDING   // renter requested, waiting for the owner
  ACCEPTED  // owner approved; slot reserved; waiting for the renter to pay (until paymentDueAt)
  CONFIRMED // paid (or grandfathered from before payments); ready for handover
  REJECTED  // owner declined, or auto-declined because the slot was given away
  CANCELLED // withdrawn by renter or owner before the rental started
  EXPIRED   // owner never responded before the start time, or renter never paid in time
  ACTIVE    // owner handed the item over; rental in progress
  COMPLETED // owner confirmed the item was returned
}

enum CancelledBy {
  RENTER
  OWNER
}

enum DepositStatus {
  NOT_COLLECTED      // nothing held: unpaid, zero deposit, or grandfathered booking
  HELD               // paid and held until the claim window after return closes
  CLAIM_OPEN         // at least one claim is open or disputed: whole deposit held
  RELEASE_PENDING    // refund of the (remaining) deposit requested, not yet processed
  REFUNDED           // fully returned
  PARTIALLY_REFUNDED // returned minus approved deductions
  FORFEITED          // fully deducted
}

model Booking {
  id           Int           @id @default(autoincrement())

  item         Item          @relation(fields: [itemId], references: [id])
  itemId       Int
  renter       User          @relation("RenterBookings", fields: [renterId], references: [id])
  renterId     Int
  // Copied from item.ownerId so owner history is a single indexed query.
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  ownerId      Int

  // Half-open interval [startTime, endTime); endTime = startTime + hours.
  startTime    DateTime      @db.Timestamptz(3)
  endTime      DateTime      @db.Timestamptz(3)
  hours        Int

  // Financial snapshot taken when the renter requests, so later price, fee
  // or deposit changes never affect this booking.
  pricePerHour    Decimal    @db.Decimal(10, 2)
  rentalAmount    Decimal    @db.Decimal(10, 2)
  platformFee     Decimal    @db.Decimal(10, 2)
  securityDeposit Decimal    @db.Decimal(10, 2)
  totalPayable    Decimal    @db.Decimal(10, 2) // rental + fee + deposit (CHECK)
  // Cancellation/refund rules this booking was made under ("LEGACY" = from
  // before payments: nothing to pay, nothing to refund).
  policyCode      String

  status       BookingStatus @default(PENDING)
  renterNote   String?
  responseNote String?
  cancelledBy  CancelledBy?
  cancelReason String?

  respondedAt  DateTime?
  cancelledAt  DateTime?
  startedAt    DateTime?
  returnedAt   DateTime?

  paymentDueAt     DateTime?     @db.Timestamptz(3) // set on acceptance
  paidAt           DateTime?
  depositStatus    DepositStatus @default(NOT_COLLECTED)
  depositReleaseAt DateTime?     @db.Timestamptz(3) // end of the claim window after return

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  notifications Notification[]
  payment       Payment?
  refunds       Refund[]
  depositClaims DepositClaim[]
  paymentEvents PaymentEvent[]
  reviews       Review[]

  @@index([itemId, startTime])
  @@index([renterId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status])
  @@index([status, paymentDueAt])
  @@index([depositStatus, depositReleaseAt])
}

enum PaymentStatus {
  CREATED  // Razorpay order exists, not paid yet (failed attempts keep it here)
  CAPTURED // money received
  VOIDED   // booking expired or was cancelled before payment
}

// The single charge for a booking: one Razorpay order, reused for retries.
model Payment {
  id                   Int           @id @default(autoincrement())
  booking              Booking       @relation(fields: [bookingId], references: [id])
  bookingId            Int           @unique // at most one charge per booking
  razorpayOrderId      String        @unique
  razorpayPaymentId    String?       @unique // the payment that paid the order
  amount               Decimal       @db.Decimal(10, 2) // booking.totalPayable when the order was created
  currency             String        @default("INR")
  status               PaymentStatus @default(CREATED)
  method               String?
  failedAttempts       Int           @default(0)
  lastErrorCode        String?
  lastErrorReason      String?
  lastErrorDescription String?
  capturedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  refunds Refund[]
  events  PaymentEvent[]

  @@index([status])
}

enum RefundPurpose {
  CANCELLATION        // cancelled after paying (amount per the booking's policy)
  DEPOSIT_RELEASE     // deposit minus approved deductions, after the claim window
  BOOKING_NOT_PAYABLE // payment captured after the booking expired or was cancelled
  DUPLICATE_PAYMENT   // a second captured payment on the same order
  ADMIN_ADJUSTMENT    // manual correction (future admin panel)
}

enum RefundStatus {
  REQUESTED // our record exists; Razorpay hasn't confirmed it yet (or the call's outcome is unknown)
  PENDING   // Razorpay accepted it and is processing
  PROCESSED // money returned
  FAILED    // Razorpay rejected or failed it; will be retried
}

enum Actor {
  RENTER
  OWNER
  ADMIN
  SYSTEM
}

model Refund {
  id                   Int           @id @default(autoincrement())
  payment              Payment       @relation(fields: [paymentId], references: [id])
  paymentId            Int
  booking              Booking       @relation(fields: [bookingId], references: [id])
  bookingId            Int
  // Usually payment.razorpayPaymentId; differs only for a duplicate payment.
  razorpayPaymentId    String
  razorpayRefundId     String?       @unique
  // One logical refund = one key ("cancel:42", "deposit:42", "dup:pay_X"...),
  // so retries and duplicate triggers can never refund twice.
  idempotencyKey       String        @unique
  purpose              RefundPurpose
  amount               Decimal       @db.Decimal(10, 2) // CHECK > 0
  breakdown            Json          // { rental, platformFee, deposit } as shown to users
  status               RefundStatus  @default(REQUESTED)
  reason               String
  initiatedBy          Actor
  initiatedById        Int?
  attempts             Int           @default(0)
  // Short lease while one process is talking to Razorpay about this refund,
  // so two senders (e.g. a request and the cron sweep) can never both create it.
  lockedUntil          DateTime?
  lastErrorCode        String?
  lastErrorDescription String?
  requestedAt          DateTime      @default(now())
  processedAt          DateTime?
  failedAt             DateTime?
  updatedAt            DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum DepositClaimReason {
  DAMAGE
  LATE_RETURN
  MISSING_PARTS
  OTHER
}

enum DepositClaimStatus {
  OPEN      // raised by the owner, waiting for the renter
  ACCEPTED  // renter agreed: amountApproved = amountClaimed
  DISPUTED  // renter disagreed: an admin decides
  APPROVED  // admin approved all or part (amountApproved)
  REJECTED  // admin rejected (nothing deducted)
  WITHDRAWN // owner withdrew it
}

model DepositClaim {
  id             Int                @id @default(autoincrement())
  booking        Booking            @relation(fields: [bookingId], references: [id])
  bookingId      Int
  raisedById     Int
  reason         DepositClaimReason
  description    String
  amountClaimed  Decimal            @db.Decimal(10, 2) // CHECK > 0
  amountApproved Decimal?           @db.Decimal(10, 2) // CHECK 0 <= approved <= claimed
  status         DepositClaimStatus @default(OPEN)
  renterResponse String?
  resolvedById   Int?
  resolutionNote String?
  createdAt      DateTime           @default(now())
  respondedAt    DateTime?
  resolvedAt     DateTime?

  @@index([bookingId])
  @@index([status])
}

enum PaymentEventSource {
  CHECKOUT_CALLBACK
  WEBHOOK
  RECONCILIATION
  USER
  ADMIN
  SYSTEM
}

// Append-only audit trail of every money-related event. Never updated or
// deleted by the application (a trigger enforces it).
model PaymentEvent {
  id              Int                @id @default(autoincrement())
  booking         Booking?           @relation(fields: [bookingId], references: [id])
  bookingId       Int?
  payment         Payment?           @relation(fields: [paymentId], references: [id])
  paymentId       Int?
  refundId        Int?
  claimId         Int?
  type            String
  source          PaymentEventSource
  actorId         Int?
  // Razorpay webhook event id (x-razorpay-event-id): a redelivered webhook
  // can't be processed twice.
  razorpayEventId String?            @unique
  amount          Decimal?           @db.Decimal(10, 2)
  data            Json
  createdAt       DateTime           @default(now())

  @@index([bookingId, createdAt])
  @@index([paymentId])
}

enum NotificationType {
  BOOKING_REQUESTED           // -> owner: a renter sent a request
  BOOKING_ACCEPTED            // -> renter: accepted, please pay
  BOOKING_REJECTED            // -> renter: owner declined
  BOOKING_AUTO_REJECTED       // -> renter: owner accepted an overlapping request
  BOOKING_CANCELLED_BY_RENTER // -> owner
  BOOKING_CANCELLED_BY_OWNER  // -> renter
  BOOKING_EXPIRED             // -> renter: owner never responded
  BOOKING_STARTED             // -> renter: item handed over
  BOOKING_COMPLETED           // -> renter: return confirmed
  PAYMENT_RECEIVED            // -> renter and owner: paid, booking confirmed
  PAYMENT_FAILED              // -> renter: a payment attempt failed
  BOOKING_PAYMENT_EXPIRED     // -> renter and owner: not paid in time, slot released
  REFUND_INITIATED            // -> renter
  REFUND_PROCESSED            // -> renter
  REFUND_FAILED               // -> renter
  DEPOSIT_CLAIM_RAISED        // -> renter
  DEPOSIT_CLAIM_ACCEPTED      // -> owner
  DEPOSIT_CLAIM_DISPUTED      // -> owner
  DEPOSIT_CLAIM_WITHDRAWN     // -> renter
  DEPOSIT_CLAIM_RESOLVED      // -> renter and owner: admin decision
  DEPOSIT_RELEASED            // -> renter and owner: deposit settled
  REVIEW_RECEIVED             // -> whoever was reviewed
}

// Persistent in-app notifications, always created server-side in the same
// transaction as the change they describe.
model Notification {
  id          Int              @id @default(autoincrement())

  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  // Nullable so future non-booking notifications fit the same table.
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   Int?

  type        NotificationType
  title       String
  message     String
  // Identifies the event ("BOOKING_ACCEPTED:booking:42", "REFUND_PROCESSED:refund:7"),
  // so a retried or redelivered event can never notify the same person twice.
  dedupeKey   String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

enum ReviewDirection {
  RENTER_TO_OWNER // the renter reviews the owner and the item
  OWNER_TO_RENTER // the owner reviews the renter
}

// One review per person per completed booking. Who wrote it, who it is
// about and which item it covers are always derived from the booking.
model Review {
  id        Int             @id @default(autoincrement())
  booking   Booking         @relation(fields: [bookingId], references: [id])
  bookingId Int
  author    User            @relation("ReviewsWritten", fields: [authorId], references: [id])
  authorId  Int
  subject   User            @relation("ReviewsReceived", fields: [subjectId], references: [id])
  subjectId Int
  // Set for renter -> owner reviews (they also rate the item).
  item      Item?           @relation(fields: [itemId], references: [id])
  itemId    Int?
  direction ReviewDirection
  rating    Int             // CHECK 1..5
  comment   String?
  createdAt DateTime        @default(now())

  @@unique([bookingId, authorId])
  @@index([subjectId, direction, createdAt])
  @@index([itemId, createdAt])
}
