# Copy this file to .env and fill in your own values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/rentany"

# Any long random string, used to sign login tokens
JWT_SECRET="replace_with_a_long_random_string"

# Port the backend server runs on
PORT=5000

# Cloudinary (free tier: https://cloudinary.com/users/register/free)
# Find these three values on your Cloudinary Dashboard home page after signup
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend origin(s) allowed to call this API (CORS). Comma-separate multiple,
# e.g. "http://localhost:5173,https://rentany.vercel.app". Defaults to
# http://localhost:5173 when not set.
CLIENT_URL="http://localhost:5173"

# Razorpay — TEST MODE ONLY (keys start with rzp_test_). Get them from the
# Razorpay Dashboard in Test Mode: Account & Settings -> API Keys.
# Without these the app runs but online payments are disabled.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_key_secret"
# Set the same secret on the webhook in the Razorpay Dashboard
# (URL: https://<backend>/api/payments/webhook; events: payment.captured,
# payment.failed, order.paid, refund.processed, refund.failed).
RAZORPAY_WEBHOOK_SECRET="any_long_random_string"

# Secret for the scheduled payment sweep (Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"). Any long random string.
CRON_SECRET="any_long_random_string"

# Grok (xAI) API key for the AI rental assistant (server-side only; never put
# it in the frontend). Create one at https://console.x.ai. Without it the
# assistant falls back to a plain catalog search.
GROK_API_KEY="xai-your_key_here"
# Optional: model and API base URL (defaults shown).
# GROK_MODEL="grok-3-mini"
# GROK_API_URL="https://api.x.ai/v1"
# Any OpenAI-compatible API works. For Groq (https://console.groq.com):
# GROK_API_KEY="gsk_your_key_here"
# GROK_API_URL="https://api.groq.com/openai/v1"
# GROK_MODEL="openai/gpt-oss-120b"
# Reasoning effort for reasoning models (default "low" for gpt-oss and
# grok-3-mini; "none" to not send it):
# GROK_REASONING_EFFORT="low"