# Copy this file to .env and fill in your own values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/rentany"

# Any long random string, used to sign login tokens
JWT_SECRET="replace_with_a_long_random_string"

# Port the backend server runs on
PORT=5000

# Cloudinary (free tier: https://cloudinary.com/users/register/free)
# Find these three values on your Cloudinary Dashboard home page after signup
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
